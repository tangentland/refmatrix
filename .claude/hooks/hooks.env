# Hook configuration for refmatrix — sourced by .claude/hooks/*.sh (see hooks.env.example).
# Mirrors .claude/PROJECT_PROFILE.md (Directory layout + Discovery corpus).

# Source root the adr-gate scans for new class definitions.
SRC_DIR="src"

# refmatrix keeps its ADRs at docs/adr (pre-dates the template's docs/architecture/adr).
ADR_DIR="docs/adr"

# Corpus roots: bare grep into these is redirected to rmx by enforce-rmx-grep.
CORPUS_PATHS="src docs workflow tests eval"

CORPUS_EXTS=".py .md .sh .json .yaml .yml .toml .txt .html .css .js .pseudo"

ADR_GATE_FILE_RE='\.py$'
