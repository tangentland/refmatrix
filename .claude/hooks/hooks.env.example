# Hook configuration — copy to `.claude/hooks/hooks.env` (the real file is gitignored) and
# adjust for this project. The enforcement hooks source this file if present, else use defaults.
# Values mirror .claude/PROJECT_PROFILE.md (Directory layout + Discovery corpus).

# Source root the adr-gate scans for new class definitions (relative to repo root).
SRC_DIR="src"

# Where ADRs live (adr-gate greps these for class-name matches).
ADR_DIR="docs/architecture/adr"

# Space-separated corpus roots. Bare grep into these is redirected to rmx by enforce-rmx-grep.
CORPUS_PATHS="src docs workflow tests"

# Source-file extensions considered "corpus" content.
CORPUS_EXTS=".py .ts .tsx .js .jsx .md .sh .json .yaml .yml .toml .txt .html .css"

# File-glob (extended regex) adr-gate inspects for new class defs. Default: Python + TS.
ADR_GATE_FILE_RE='\.(py|ts|tsx)$'
