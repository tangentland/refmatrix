        if (res.get("promoted") or {}).get("error"):
            failed.append(f"its promote failed: {res['promoted']['error']}")
        if (res.get("sync") or {}).get("error"):
            failed.append(f"its memory bridge failed: {res['sync']['error']}")
        if failed:
