        (memdir / "MEMORY.md").write_text("\n".join([
            inside, before,
            f"- [Plain]({plain_rel}) — curated plain",
            f"- [Gone]({gone_rel}) — a memory whose file was deleted",
        ]) + "\n", encoding="utf-8")
        if organised:
            organise(memdir)
        r = run_entry(memdir)
        said = r.stdout + r.stderr
