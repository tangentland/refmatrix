"""THROWAWAY probe (not committed): does a file / subdir target re-type a misfiled save-state?"""
import pytest
from tests.test_savestate_mtype import (inproc, organise, savestate, at, _mtypes, _invoke,  # noqa: F401
                                        RS)


@pytest.mark.parametrize("target", ["file", "subdir", "memdir"])
def test_probe(inproc, target):
    base, root = inproc
    memdir = base / "memory"
    memdir.mkdir()
    organise(memdir)
    p = savestate(memdir, "feedback/savestate_misfiled.md", mtype="project",
                  created="2026-07-07", updated="2026-07-08", mtime=at(2026, 7, 8))
    t = {"file": p, "subdir": p.parent, "memdir": memdir}[target]
    out = _invoke(["ingest-gmd", "--as-memory", str(t)]).output
    print(out)
    assert _mtypes(root)["savestate_misfiled"] == "project", out
