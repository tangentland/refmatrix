                from refmatrix.daemon import Daemon, _op_ingest_gmd
                d = Daemon(root)
                d.store = _open(root)
                try:
                    _op_ingest_gmd(d, {"targets": [str(target)]})
                finally:
                    d.store.close()
            else:
                from click.testing import CliRunner
    
                from refmatrix import cli as cli_mod
                monkeypatch.setenv("REFMATRIX_ROOT", str(root))
