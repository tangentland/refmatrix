    @pytest.mark.parametrize("route", ["op", "cli"])
    def test_ingest_gmd_on_a_subdir_reads_the_spec_from_the_project_root(route, monkeypatch):
        """`rmx ingest-gmd docs/` must find the project root by walking up to `.refmatrix/` and
