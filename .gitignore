# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/

# Test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# Refmatrix runtime / derived state (not portable across branches — see store.py)
.refmatrix/
.memory.db
.tldr/

# Eval — large downloads + generated runs (keep metrics.json + REPORT.md trackable)
eval/datasets/
eval/results/*/*/run.tsv
eval/results/*_run.log
.venv-eval/

# Tooling / local
# .claude/ IS committed (cat-herder baseline: agents, commands, hooks, PROJECT_PROFILE, settings.json).
# Only per-machine state stays out. The rmx block in settings.json is generated by
# `rmx install-hooks` — committed, never hand-edited (CLAUDE.md).
.claude/settings.local.json
.claude/settings.local.json.bak
.claude/cam_local/
workflow/review-output/
.tldrignore
graphify-out/
.idea/
